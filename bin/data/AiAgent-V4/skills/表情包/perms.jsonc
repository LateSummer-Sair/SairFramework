{
  "version": 6,
  "_readme": "技能管控表（基板读这一份；以 // 开头的整行是注释，只给人看，读之前整行丢掉）。三个块：Skill = 谁能用哪些 op；DB = 谁能改 / 谁能读哪类数据（改命中后还要看这一行是不是他自己的）；File = 谁能碰哪些路径（目录写成末尾带斜杠 = 整棵子树，最长路径优先）。规则层的键一律写成中括号数组：[\"a\", \"b\"] 与分别写 \"a\" 与 \"b\" 等价。优先级：更具体的键优先，同一个键上 Ban 压过 Run 与 Read；没列到：Skill 不能用、DB 能读不能改、File 不能碰。身份写法：user:<QQ> / group:<群号> / ALLUSER（裸 QQ 号 = user:<QQ>）；主人（MASTER）与她本人（SYSTEM）恒全权，不受本表影响，不用写进表里",

  // ───────── 技能：谁能用哪些 op ─────────
  "Skill": {
    // ── 谁能用（没列到 = 未授权）
    "Run": {
      // ── 表情包库的收发与打理（sticker）
      // 列表情包库
      // 按语境发一张表情包
      // ★ 2026-09-24 GM 裁定：ALLUSER 的 Run 面**只放这一条非读 op**（sticker.send）——
      //   甲方令「她得自发愿意发表情包」，而群友触发的回合里她想发也会被权限挡住 ⇒ 必须放行。
      ["sticker.list", "sticker.send"]: ["ALLUSER"]
    },
    // ── 谁不能用（压过 Run）
    "Ban": {
      // ── 表情包库的收发与打理（sticker）
      // 清空表情包库
      // 收藏一张表情包（防群友投毒：谁能让她收图 = 谁能往她库里塞东西）
      // 改某张的语境 / 备注（2026-09-24 GM 裁定：备注会进她的上下文 ⇒ 对非主人是**低危但持久**的注入面，从 Run 移到 Ban）
      ["sticker.clear", "sticker.collect", "sticker.remark"]: ["ALLUSER"],

      // ── QQ 侧自定义表情（sticker 的 cf_* 四个动作；NapCat 4.18.5+）
      // 动的是 QQ 账号侧的真实资源（不是本机库）⇒ 读也一并收紧：非主人一律拒。
      // 取自定义表情详情 / 列表
      // 添加一条自定义表情
      // 删除一条自定义表情（还要 confirm 二次确认）
      // 改一条自定义表情的描述
      ["sticker.cf_list", "sticker.cf_add", "sticker.cf_del", "sticker.cf_desc"]: ["ALLUSER"]
    }
  }
}
